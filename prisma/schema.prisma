generator client {
    provider = "prisma-client-js"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

model Product {
    id String @id @default(cuid())
    userId String // Neon Auth ID
    name String
    sku String? @unique // ? means optional
    price Decimal @db.Decimal(12, 2) // 12, 2 means 12 total digits and 2 digit after . counted in 12
    quantity Int @default(0)
    lowStockAt Int?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // For better search result
    @@index([userId, name])
    @@index([createdAt])
}
